  <name>Breeze</name>
  <summary>KDE Plasma's Breeze look, light</summary>
  <description>
    <p>The default look of KDE Plasma, for COSMIC: Breeze's light colors with its icons, cursors and wallpaper.</p>
  </description>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <icon type="stock">preferences-other-symbolic</icon>
  <custom>
    <value key="x-cosmic-format">1</value>
    <value key="x-cosmic-version">1.0.0</value>
    <value key="x-cosmic-slug">breeze</value>
    <value key="x-cosmic-mode">light</value>
    <value key="x-cosmic-parts">Theme,Builder,Background</value>
